{
  "name": "@nmakarov/cli-toolkit",
  "version": "0.74.0",
  "description": "A comprehensive toolkit for building CLI applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./args": {
      "import": "./dist/args.js",
      "require": "./dist/args.cjs"
    },
    "./params": {
      "import": "./dist/params.js",
      "require": "./dist/params.cjs"
    },
    "./init": {
      "import": "./dist/init.js",
      "require": "./dist/init.cjs"
    },
    "./http-client": {
      "import": "./dist/http-client.js",
      "require": "./dist/http-client.cjs"
    },
    "./http-client2": {
      "import": "./dist/http-client2.js",
      "require": "./dist/http-client2.cjs"
    },
    "./mock-server": {
      "import": "./dist/mock-server.js",
      "require": "./dist/mock-server.cjs"
    },
    "./screen": {
      "import": "./dist/screen.js",
      "require": "./dist/screen.cjs"
    },
    "./errors": {
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./logger": {
      "import": "./dist/logger.js",
      "require": "./dist/logger.cjs"
    },
    "./filedatabase": {
      "import": "./dist/filedatabase.js",
      "require": "./dist/filedatabase.cjs"
    },
    "./db": {
      "import": "./dist/db.js",
      "require": "./dist/db.cjs"
    },
    "./s3": {
      "import": "./dist/s3.js",
      "require": "./dist/s3.cjs"
    },
    "./aws": {
      "import": "./dist/aws.js",
      "require": "./dist/aws.cjs"
    },
    "./deploy": {
      "import": "./dist/deploy.js",
      "require": "./dist/deploy.cjs"
    },
    "./tasks": {
      "import": "./dist/tasks.js",
      "require": "./dist/tasks.cjs"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    }
  },
  "bin": {
    "cli-runner": "./dist/cli-runner.js",
    "cli-deploy": "./scripts/deploy/cli.js",
    "cli-aws-discover": "./scripts/aws/discover.js",
    "cli-send-task": "./scripts/send-task.js"
  },
  "scripts": {
    "ssm:list": "node scripts/ssm/ssm-admin.js list",
    "ssm:get": "node scripts/ssm/ssm-admin.js get",
    "ssm:put": "node scripts/ssm/ssm-admin.js put",
    "ssm:pull": "node scripts/ssm/ssm-pull.js",
    "tasks:monitor": "node scripts/tasks-monitor.js",
    "tasks:send": "node scripts/send-task.js",
    "tasks:ensure-dummy-harvest": "node scripts/ensure-dummy-harvest.js",
    "build": "tsup && node scripts/fix-cjs-esm-deps.js",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:coverage:open": "vitest --coverage && open coverage/index.html",
    "test:ci": "vitest run src/args/tests/args.ci.test.js src/params/tests/params.ci.test.js src/errors/tests/errors.ci.test.js src/screen/tests/screen.ci.test.js src/logger/tests/logger.ci.test.js src/filedatabase/tests/filestore.ci.test.js src/filedatabase/tests/synopsis-functions.ci.test.js src/http-client/tests/http-client.ci.test.js src/http-client2/tests/http-client2.ci.test.js src/mock-server/tests/mock-server.ci.test.js src/mock-server/tests/mock-storage.ci.test.js src/db/tests/db.ci.test.js src/utils/tests/format-utils.ci.test.js src/utils/tests/date-utils.ci.test.js src/utils/tests/crypto-utils.ci.test.js src/utils/tests/fs-utils.ci.test.js src/utils/tests/os-utils.ci.test.js src/init/tests/init.ci.test.js src/tasks/tests/runtime-params.ci.test.js src/tasks/tests/pause-runner.ci.test.js --coverage",
    "test:args": "vitest run src/args/tests",
    "test:args:ci": "vitest run src/args/tests/args.ci.test.js --coverage",
    "test:params": "vitest run src/params/tests",
    "test:params:ci": "vitest run src/params/tests/params.ci.test.js --coverage",
    "test:errors": "vitest run src/errors/tests",
    "test:errors:ci": "vitest run src/errors/tests/errors.ci.test.js --coverage",
    "test:screen": "vitest run src/screen/tests",
    "test:screen:ci": "vitest run src/screen/tests/screen.ci.test.js --coverage",
    "test:logger": "vitest run src/logger/tests/logger.cli.test.js",
    "test:logger:ci": "vitest run src/logger/tests/logger.ci.test.js --coverage",
    "test:filedatabase": "vitest run src/filedatabase/tests",
    "test:filedatabase:ci": "vitest run src/filedatabase/tests/filestore.ci.test.js --coverage",
    "test:synopsis": "vitest run src/filedatabase/tests/synopsis-functions.ci.test.js",
    "test:synopsis:ci": "vitest run src/filedatabase/tests/synopsis-functions.ci.test.js --coverage",
    "test:http-client": "vitest run src/http-client/tests",
    "test:http-client:ci": "vitest run src/http-client/tests/http-client.ci.test.js --coverage",
    "test:http-client:ci:real-timeouts": "HTTP_CLIENT_REAL_TIMEOUTS=true vitest run src/http-client/tests/http-client.ci.test.js --coverage",
    "test:http-client2": "vitest run src/http-client2/tests",
    "test:http-client2:ci": "vitest run src/http-client2/tests/http-client2.ci.test.js --coverage",
    "test:mock-server": "vitest run src/mock-server/tests",
    "test:mock-server:ci": "vitest run src/mock-server/tests/mock-server.ci.test.js src/mock-server/tests/mock-storage.ci.test.js --coverage",
    "test:mock-server:coverage": "vitest run src/mock-server/tests --coverage",
    "test:db": "vitest run src/db/tests",
    "test:db:ci": "vitest run src/db/tests/db.ci.test.js --coverage",
    "test:utils": "vitest run src/utils/tests",
    "test:utils:ci": "vitest run src/utils/tests/*.ci.test.js --coverage",
    "test:init": "vitest run src/init/tests",
    "test:init:ci": "vitest run src/init/tests/init.ci.test.js --coverage",
    "lint": "eslint src/",
    "prepublishOnly": "npm run test:ci && npm run build",
    "release:patch": "npm version patch && npm publish --access public && git push --follow-tags",
    "release:minor": "npm version minor && npm publish --access public && git push --follow-tags",
    "release:major": "npm version major && npm publish --access public && git push --follow-tags"
  },
  "keywords": [
    "cli",
    "args",
    "params",
    "bootstrap",
    "toolkit",
    "javascript",
    "terminal",
    "ui",
    "ink",
    "react",
    "screen",
    "tui",
    "interactive",
    "menu",
    "grid",
    "navigation"
  ],
  "author": "nmakarov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nmakarov/cli-toolkit.git"
  },
  "files": [
    "dist/",
    "scripts/ssm/",
    "scripts/deploy/",
    "scripts/aws/",
    "scripts/send-task.js",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@vitest/coverage-v8": "^4.0.3",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1075.0",
    "@aws-sdk/client-route-53": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/client-ssm": "^3.750.0",
    "@aws-sdk/client-sts": "^3.1075.0",
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "dotenv": "^17.2.3",
    "express": "^4.18.0",
    "joi": "^18.0.1",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "mysql": "^2.18.1",
    "pg": "^8.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "ink": "^4.0.0",
    "mysql2": "^3.0.0",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  }
}
